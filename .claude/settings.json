{
  "mcpServers": {
    "mysql": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-mysql", "--port", "3306"],
      "env": {
        "DB_HOST": "${DB_HOST:localhost}",
        "DB_USER": "${DB_USER:root}",
        "DB_PASSWORD": "${DB_PASSWORD:}",
        "DB_NAME": "${DB_NAME:patient_health_db}",
        "DB_PORT": "${DB_PORT:3306}"
      },
      "disabled": false
    }
  },
  "env": {
    "DB_HOST": "localhost",
    "DB_USER": "root",
    "DB_PASSWORD": "",
    "DB_NAME": "patient_health_db",
    "DB_PORT": "3306"
  },
  "permissions": {
    "bash": {
      "allowed": [
        "git",
        "npm",
        "python",
        "pytest",
        "mysql"
      ]
    }
  }
}
